# Avisos administrativos. Use as variáveis de ambiente da Vercel; nunca publique valores reais.
# Gmail: SMTP_USER = conta remetente; SMTP_PASS = senha de app, não a senha normal.
SMTP_USER=
SMTP_PASS=
# Padrões opcionais para Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Se o provedor usa um login diferente do endereço do remetente, preencha SMTP_FROM.
SMTP_FROM=
# Segredo aleatório para a retentativa diária. Guarde apenas na Vercel/gerenciador de senhas.
CRON_SECRET=
